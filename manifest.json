{
  "id": "top.qomicex.assistant",
  "name": "AI 助手",
  "version": "2.2.0",
  "minLauncherVersion": "0.1.0",
  "layers": ["l2", "l3"],
  "permissions": [
    "config:read",
    "config:write",
    "network:fetch",
    "network:cors_proxy",
    "cache:access",
    "filesystem:read",
    "filesystem:write",
    "shell:execute",
    "ui:toast",
    "ui:sub_window",
    "download:manage",
    "instance:write"
  ],
  "dependencies": [
    { "id": "top.qomicex.markdown", "version": ">=1.0.0", "optional": true },
    { "id": "top.qomicex.markitdown", "version": ">=0.1.0", "optional": true }
  ],
  "entry": {
    "frontend": "dist/agent.html",
    "theme": "dist/theme.css"
  },
  "contributes": {
    "menuItems": [
      {
        "path": "/plugins/p/top.qomicex.assistant",
        "label": "AI 助手",
        "icon": "fa-solid fa-robot",
        "action": "page"
      }
    ],
    "slots": [{ "slot": "header:right", "file": "dist/slots.html", "width": 300, "height": 36 }],
    "settingsPages": ["dist/index.html"]
  }
}